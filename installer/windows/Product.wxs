<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Apex Auto-Clicker"
    Manufacturer="Kastrick"
    Version="$(var.ProductVersion).0"
    UpgradeCode="D17F5A3C-6B4E-4A73-9D51-8DA49F6A5011"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Apex Auto-Clicker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainApplication" Title="Apex Auto-Clicker" Level="1">
      <ComponentRef Id="ApplicationExecutable" />
      <ComponentRef Id="ApplicationLicense" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="KastrickSoftwareFolder" Name="kastrick's_software">
        <Directory Id="INSTALLFOLDER" Name="aac">
          <Component Id="ApplicationExecutable" Guid="D17F5A3C-6B4E-4A73-9D51-8DA49F6A5012">
            <File Id="ApplicationExe" Source="$(var.AppExe)" KeyPath="yes" />
          </Component>
          <Component Id="ApplicationLicense" Guid="D17F5A3C-6B4E-4A73-9D51-8DA49F6A5014">
            <File Id="ApplicationLicenseFile" Source="$(var.LicenseFile)" Name="LICENSE.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Apex Auto-Clicker">
        <Component Id="ApplicationShortcut" Guid="D17F5A3C-6B4E-4A73-9D51-8DA49F6A5013">
          <Shortcut
            Id="StartMenuShortcut"
            Name="Apex Auto-Clicker"
            Target="[INSTALLFOLDER]apex-autoclicker.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKLM"
            Key="Software\Kastrick\ApexAutoClicker"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
